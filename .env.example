# Zkopírujte na .env a doplňte hodnoty ze sekce POVINNÉ.
# .env je v .gitignore a nikdy se necommituje.
#
# Zbytek má rozumné výchozí hodnoty — hodí se, až budete aplikaci ladit
# na svoje poměry.

# ═══════════════════════════════════════════════════════════════
#  POVINNÉ — bez nich sestava nenastartuje
# ═══════════════════════════════════════════════════════════════

# Heslo správce databáze a heslo aplikačního uživatele. Zvolte si vlastní.
# Vygenerovat: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""

# Podpis přihlašovacího tokenu, alespoň 32 znaků.
# Vygenerovat: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# Bankovní účet farmy pro QR platby. Mezery jsou povolené, aplikace je odstraní,
# a kontrolní číslice se ověřují — překlep by posílal zákazníky platit jinam.
BANK_ACCOUNT_IBAN="CZ65 0800 0000 1920 0014 5399"
# Číslo účtu tak, jak ho má vidět zákazník v e-mailu a na stránce potvrzení.
BANK_ACCOUNT_NUMBER="2000145399/0800"

# Heslo farmáře, kterého založí seed. Bez něj seed skončí chybou.
SEED_FARMER_PASSWORD=""
# Jméno farmáře, jak se ukáže v administraci.
SEED_FARMER_NAME="Farmář"

# ═══════════════════════════════════════════════════════════════
#  IDENTITA FARMY — patička, hlavička a podpis pod každým e-mailem
# ═══════════════════════════════════════════════════════════════

FARM_NAME="SilentAgro"
FARM_LEGAL_NAME="Silent Industries"
FARM_COMPANY_ID="12345678"
FARM_PHONE="+420 777 123 456"

# Kontaktní adresa farmy. Chodí sem upozornění na nové objednávky a je to zároveň
# přihlašovací jméno farmáře, kterého založí seed.
FARMER_EMAIL="farma@silentagro.cz"

# ═══════════════════════════════════════════════════════════════
#  POŠTA
# ═══════════════════════════════════════════════════════════════

# mailpit = odchytávač pro vývoj (nic se reálně neodešle, UI na http://localhost:8025)
# smtp    = skutečný SMTP server
# memory  = nic neodesílá, drží zprávy v paměti (testy); v produkci zakázáno
MAIL_DRIVER="mailpit"
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SilentAgro <farma@silentagro.cz>"

# ═══════════════════════════════════════════════════════════════
#  OBCHODNÍ PRAVIDLA
# ═══════════════════════════════════════════════════════════════

# Poplatek za rozvoz a hranice, nad kterou je zdarma. Hranice je ostrá:
# přesně na této částce se ještě účtuje.
DELIVERY_FEE_CZK="60"
FREE_DELIVERY_ABOVE_CZK="600"

# Do kolika kilometrů farma rozváží (text na homepage).
DELIVERY_RADIUS_KM="20"

# Jak dlouho se rezervace drží (text v e-mailu a v košíku).
RESERVATION_HOLD_DAYS="5"

# ═══════════════════════════════════════════════════════════════
#  PROVOZ
# ═══════════════════════════════════════════════════════════════

# development | test | production
# Záměrně se nečte NODE_ENV: standalone build Next.js si ho nastavuje natvrdo
# na "production", takže by se podle něj nedala rozlišit vývojová sestava.
APP_ENV="production"

# Veřejná adresa aplikace. Skládají se z ní odkazy v e-mailech, takže v produkci
# sem patří skutečná doména, ne localhost.
PUBLIC_BASE_URL="http://localhost:3000"

# Porty na hostiteli. Aplikace i odchytávač pošty poslouchají jen na 127.0.0.1.
# Změňte je, když už máte na těchto číslech něco jiného.
APP_PORT="3000"
MAILPIT_UI_PORT="8025"

# Jméno databáze a aplikačního uživatele. Měnit není potřeba.
MYSQL_DATABASE="silentagro"
MYSQL_USER="silentagro"

# Zapnout jen za reverzní proxy, která X-Forwarded-For skutečně nastavuje.
# Bez proxy si hlavičku nastaví kdokoli a limit podle IP jde obejít.
TRUST_PROXY="false"

# Limity pokusů, počítané na účet (ne globálně).
RATE_LIMIT_LOGIN_PER_15MIN="5"
RATE_LIMIT_REGISTER_PER_HOUR="3"
RATE_LIMIT_ORDERS_PER_HOUR="10"

# ═══════════════════════════════════════════════════════════════
#  JEN PRO VÝVOJ MIMO DOCKER
# ═══════════════════════════════════════════════════════════════

# V docker compose se DATABASE_URL skládá automaticky z MYSQL_* proměnných,
# takže tuhle hodnotu využijete jen při `npm run dev` na vlastním stroji.
DATABASE_URL="mysql://silentagro:silentagro@localhost:3307/silentagro"

# Databáze pro integrační testy. MUSÍ být jiná než DATABASE_URL — testy mažou
# tabulky a helper se odmítne spustit, když se obě shodují.
TEST_DATABASE_URL="mysql://silentagro:silentagro@localhost:3307/silentagro_test"
