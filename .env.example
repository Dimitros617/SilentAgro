# Zkopírujte na .env a doplňte skutečné hodnoty.
# .env je v .gitignore a nikdy se necommituje.

# --- Prostředí ---
# development | test | production
# Záměrně se nečte NODE_ENV: standalone build Next.js si ho nastavuje natvrdo na
# "production", takže by se v kontejneru nedala spustit vývojová sestava.
APP_ENV="development"

# --- Databáze ---
# Lokální vývoj mimo Docker (kontejner mapuje 3306 na 3307, aby nekolidoval s místní MySQL):
DATABASE_URL="mysql://silentagro:silentagro@localhost:3307/silentagro"
# Uvnitř docker compose se použije název služby:
# DATABASE_URL="mysql://silentagro:HESLO@db:3306/silentagro"

# --- Autentizace ---
# Alespoň 32 znaků. Vygenerovat: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# --- Pošta ---
# mailpit = odchytávač pro vývoj (nic se reálně neodešle, UI na http://localhost:8025)
# smtp    = skutečný SMTP server (povinné v produkci)
# memory  = nic neodesílá, drží zprávy v paměti (testy)
MAIL_DRIVER="mailpit"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SilentAgro <farma@silentagro.cz>"
FARMER_EMAIL="farma@silentagro.cz"

# --- Bankovní účet pro QR platbu ---
# POZOR: níže je ukázkový testovací IBAN. Nasadit s ním do provozu znamená posílat
# zákazníky platit na cizí účet. Před ostrým během vyplňte účet farmy.
# Mezery jsou povolené, aplikace je odstraní. Kontrolní číslice se ověřují mod-97.
BANK_ACCOUNT_IBAN="CZ65 0800 0000 1920 0014 5399"
# Číslo účtu tak, jak ho má vidět zákazník v e-mailu a na stránce potvrzení.
BANK_ACCOUNT_NUMBER="2000145399/0800"

# --- Aplikace ---
PUBLIC_BASE_URL="http://localhost:3000"
UPLOAD_DIR="./public/uploads"

# Zapnout jen za reverzní proxy, která X-Forwarded-For skutečně nastavuje.
# Bez proxy si hlavičku nastaví kdokoli a rate limit podle IP jde obejít.
TRUST_PROXY="false"

# --- Jen pro seed, za běhu se nepoužívá ---
# Heslo farmáře farma@silentagro.cz. Bez něj seed skončí chybou.
SEED_FARMER_PASSWORD=""

# --- Integrační testy ---
# MUSÍ mířit na jinou databázi než DATABASE_URL — testy mažou tabulky.
TEST_DATABASE_URL="mysql://silentagro:silentagro@localhost:3307/silentagro_test"
