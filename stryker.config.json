{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "mutate": [
    "src/domain/value-objects/money.ts",
    "src/domain/value-objects/kilograms.ts",
    "src/domain/entities/order.ts",
    "src/application/use-cases/reserve-order.ts",
    "src/application/use-cases/cancel-order.ts"
  ],
  "concurrency": 2,
  "timeoutMS": 10000,
  "ignorePatterns": [".next", "reports", "coverage", "dist", "public", ".env", ".env.*", "tests/integration", "tests/e2e", "tests/scanners"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "clearTextReporter": { "reportTests": false, "reportMutants": false },
  "htmlReporter": { "fileName": "reports/quality/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/quality/mutation/mutation.json" },
  "thresholds": { "high": 90, "low": 80, "break": 80 }
}
