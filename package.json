{
  "name": "silentagro",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:build": "esbuild scripts/mail-worker.ts --bundle --platform=node --target=node22 --external:@prisma/client --outfile=dist/mail-worker.cjs",
    "worker": "node --env-file-if-exists=.env dist/mail-worker.cjs",
    "lint": "eslint .",
    "quality:scan": "node scripts/quality-scan.mjs",
    "quality:sonar": "eslint src scripts prisma --config eslint.quality.config.mjs",
    "quality:duplicates": "jscpd src scripts prisma --config .jscpd.json",
    "quality:unused": "knip",
    "quality:trivy": "node scripts/trivy-scan.mjs",
    "quality:architecture": "depcruise --config .dependency-cruiser.mjs --output-type err-long src",
    "quality:architecture:test": "node --test tests/scanners/architecture.test.mjs",
    "quality:mutation": "stryker run",
    "quality:semgrep": "node scripts/semgrep-scan.mjs",
    "quality:semgrep:test": "node scripts/semgrep-scan.mjs --test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.3",
    "nodemailer": "^10.0.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "18.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-sonarjs": "4.2.0",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  }
}
